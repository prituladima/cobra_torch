<!-- version (version.properties), idea-version (since-build only, no upper bound) and the description
     (README.md's "What it can do", as HTML) are filled in by Gradle -->
<idea-plugin>
  <id>com.prituladima.cobratorch</id>
  <name>Cobra torch</name>
  <vendor email="prituladima@gmail.com" url="https://github.com/prituladima/cobra_torch">prituladima</vendor>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>
  <depends>org.jetbrains.plugins.yaml</depends>
  <!-- The logos next to Python imports need the Python plugin; without it everything else still works. -->
  <depends optional="true" config-file="conda-python.xml">PythonCore</depends>
  <!-- JNA for the system monitor (OSHI): part of the platform up to 2026.2, a bundled plugin from 2026.3. -->
  <depends optional="true" config-file="cobra-jna.xml">com.intellij.modules.jna</depends>

  <resource-bundle>messages.CondaEnvBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <fileIconProvider implementation="com.prituladima.plugin.intellij.CondaFileIconProvider" order="first"/>
    <toolWindow id="CobraTorchMonitor" anchor="bottom" icon="AllIcons.Toolwindows.ToolWindowProfiler"
                factoryClass="com.prituladima.plugin.intellij.MonitorToolWindowFactory" doNotActivateOnStart="true"/>
    <codeInsight.lineMarkerProvider language="yaml"
                                    implementationClass="com.prituladima.plugin.intellij.CondaEnvLineMarkerProvider"/>
    <codeInsight.declarativeInlayProvider language="yaml"
                                          implementationClass="com.prituladima.plugin.intellij.CondaEnvVersionInlayProvider"
                                          providerId="com.prituladima.cobratorch.versions"
                                          isEnabledByDefault="true" group="VALUES_GROUP"
                                          bundle="messages.CondaEnvBundle"
                                          nameKey="inlay.versions.name" descriptionKey="inlay.versions.description"/>
    <!-- Settings | Tools | Cobra torch: what the System Monitor shows -->
    <applicationConfigurable parentId="tools" id="com.prituladima.cobratorch.settings" displayName="Cobra torch"
                             instance="com.prituladima.plugin.intellij.CobraTorchConfigurable"/>
  </extensions>

  <projectListeners>
    <!-- the toolbar at the top of .conda_env.yml editors -->
    <listener class="com.prituladima.plugin.intellij.CondaEnvToolbar"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>

  <actions>
    <action id="com.prituladima.cobratorch.NewCondaEnvFile"
            class="com.prituladima.plugin.intellij.NewCondaEnvFileAction"
            text="Conda Env File" description="Create .conda_env.yml in this directory">
      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
    </action>
    <action id="com.prituladima.cobratorch.SystemMonitor"
            class="com.prituladima.plugin.intellij.OpenMonitorAction"
            text="System Monitor" description="CPU cores, RAM, VRAM, GPU load and temperatures over the last minute"
            icon="AllIcons.Toolwindows.ToolWindowProfiler">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="com.prituladima.cobratorch.Settings"
            class="com.prituladima.plugin.intellij.OpenSettingsAction"
            text="Cobra torch settings" description="What the System Monitor shows"
            icon="/icons/settings/cobraTorch.svg">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>

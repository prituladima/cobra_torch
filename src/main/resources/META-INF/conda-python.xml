<!-- Loaded only when the Python plugin (PythonCore) is enabled. -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <fileIconProvider implementation="com.prituladima.plugin.intelij.CondaFileIconProvider" order="first"/>
    <!-- package logos next to imports; Python also covers the code cells of Jupyter notebooks -->
    <codeInsight.lineMarkerProvider language="Python"
                                    implementationClass="com.prituladima.plugin.intelij.ImportLineMarkerProvider"/>
  </extensions>
</idea-plugin>
